# autoparts-server environment template
# Copy to `.env` and fill in real values. `.env` must never be committed.
# Only MONGODB_URI, JWT_ACCESS_SECRET and JWT_REFRESH_SECRET are mandatory;
# everything else falls back to the defaults shown here (see src/config/env.ts).

NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
# Comma-separated origins, or * for all. Must NOT be * in production.
CORS_ORIGINS=*

# --- Database (required) ---
MONGODB_URI=mongodb://127.0.0.1:27017/autoparts

# --- Auth secrets (required, min 16 chars each) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=30d

BCRYPT_SALT_ROUNDS=12

# --- OTP ---
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
# Return OTPs in API responses for local testing. MUST be false in production.
OTP_DEBUG_RETURN=false

# --- Image uploads (Cloudinary optional; blank = disabled) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=autoparts/products
UPLOAD_MAX_FILE_SIZE_MB=5
UPLOAD_MAX_FILES=8

# --- Payments ---
# "mock" for local dev; "razorpay" (with keys below) for real gateway.
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_CURRENCY=INR

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=20

# --- Seed admin (used by `npm run seed`) ---
SEED_ADMIN_NAME=Store Admin
SEED_ADMIN_EMAIL=admin@autoparts.test
SEED_ADMIN_MOBILE=9800000001
SEED_ADMIN_PASSWORD=Admin@12345
